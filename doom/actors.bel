; Doom in Bel: things.  Monsters, items, decorations and effects are all
; mobjs ("map objects"): property lists, replaced rather than changed.
;
; mobj keys: id x y z angle class args info sprite frames frame radius sec
;            state tics hp solid shootable bright

;;;; Kinds

; Every thing type on E1M1: (type sprite frames radius class . args)
(set kinds
  '((3004 POSS "AB"     20 zombie)
    (9    SPOS "AB"     20 sergeant)
    (3001 TROO "AB"     20 imp)
    (3002 SARG "AB"     30 demon)
    (58   SARG "AB"     30 demon)
    (2035 BAR1 "AB"     10 barrel)
    (2014 BON1 "ABCDCB" 20 health 1 200)
    (2011 STIM "A"      20 health 10 100)
    (2012 MEDI "A"      20 health 25 100)
    (2013 SOUL "ABCDCB" 20 health 100 200)
    (2023 PSTR "A"      20 health 100 100)
    (2015 BON2 "ABCDCB" 20 armor 1 200)
    (2018 ARM1 "AB"     20 armor 100 100)
    (2019 ARM2 "AB"     20 armor 200 200)
    (2007 CLIP "A"      20 ammo 10)
    (2048 AMMO "A"      20 ammo 50)
    (8    BPAK "A"      20 ammo 20)
    (2008 SHEL "A"      20 item)
    (2049 SBOX "A"      20 item)
    (2010 ROCK "A"      20 item)
    (2046 BROK "A"      20 item)
    (2047 CELL "A"      20 item)
    (17   CELP "A"      20 item)
    (2001 SHOT "A"      20 ammo 8)
    (2002 MGUN "A"      20 ammo 20)
    (2003 LAUN "A"      20 item)
    (2004 PLAS "A"      20 item)
    (2005 CSAW "A"      20 item)
    (5    BKEY "AB"     20 item)
    (47   SMIT "A"      16 obstacle)
    (54   TRE2 "A"      32 obstacle)
    (43   TRE1 "A"      16 obstacle)
    (2028 COLU "A"      16 obstacle)
    (48   ELEC "A"      16 obstacle)
    (26   POL6 "AB"     16 obstacle)
    (60   GOR4 "A"      16 hanging)
    (15   PLAY "N"      16 decor)
    (10   PLAY "W"      16 decor)
    (12   PLAY "W"      16 decor)
    (18   POSS "L"      16 decor)
    (19   SPOS "L"      16 decor)
    (20   TROO "M"      16 decor)
    (21   SARG "N"      16 decor)
    (24   POL5 "A"      16 decor)))

; (class health speed pain-chance pain-frame death-frames attack sounds)
; attack: (kind shots damage-unit damage-dice frames), the last frame fires.
; sounds: (sight pain death attack)
(set monster-classes
  '((zombie   20  2.5 200 \G "HIJKL"  (bullets 1 3 5  "EF")
              ("DSPOSIT1" "DSPOPAIN" "DSPODTH1" "DSPISTOL"))
    (sergeant 30  2.5 170 \G "HIJKL"  (bullets 3 3 5  "EF")
              ("DSPOSIT2" "DSPOPAIN" "DSPODTH2" "DSSHOTGN"))
    (imp      60  3 200 \H "IJKLM"  (bullets 1 3 8  "EFG")
              ("DSBGSIT1" "DSPOPAIN" "DSBGDTH1" "DSFIRSHT"))
    (demon    150 5 180 \H "IJKLMN" (bite    1 4 10 "EFG")
              ("DSSGTSIT" "DSDMPAIN" "DSSGTDTH" "DSSGTATK"))))


;;;; Spawning

(def spawn-things (lv)
  (keep idfn
        (map (fn ((x y angle type flags) i)
               (let k (get type kinds)
                 (if (and k (flag flags 2) (no (flag flags 16)))
                     (new-mobj k i x y (/ (* angle pi) 180) (point-sector (at 'root lv) x y)))))
             (at 'things lv)
             (iota (len (at 'things lv))))))

(def new-mobj (k id x y angle sec)
  (withs ((type sprite frames radius class . args) k
          info (cdr (get class monster-classes)))
    (list (cons 'id id) (cons 'x x) (cons 'y y) (cons 'z nil) (cons 'angle angle)
          (cons 'class class) (cons 'args args) (cons 'info info)
          (cons 'sprite (nom sprite)) (cons 'frames frames)
          (cons 'frame (if info (car frames)))
          (cons 'radius radius) (cons 'sec sec)
          (cons 'state (if info 'idle)) (cons 'tics 0)
          (cons 'hp (if info (car info) (= class 'barrel) 20 0))
          (cons 'solid (in class 'zombie 'sergeant 'imp 'demon 'barrel 'obstacle))
          (cons 'shootable (in class 'zombie 'sergeant 'imp 'demon 'barrel))
          (cons 'bright nil))))

; Puffs, blood and explosions: short animations that remove themselves.
(def spawn-effect (w sprite frames x y z)
  (puts w
        'mobjs  (cons (list (cons 'id (at 'next-id w)) (cons 'x x) (cons 'y y) (cons 'z z)
                            (cons 'angle 0) (cons 'class 'effect) (cons 'sprite sprite)
                            (cons 'frames frames) (cons 'frame (car frames))
                            (cons 'sec (point-sector (at 'root (at 'lv w)) x y))
                            (cons 'state 'anim) (cons 'tics 0) (cons 'radius 0)
                            (cons 'bright (= sprite "PUFF")))
                      (at 'mobjs w))
        'next-id (+ 1 (at 'next-id w))))

(def sound (w name)
  (puts w 'sounds (cons name (at 'sounds w))))

(def monster-sound (w m i)
  (sound w (nth i (nth 7 (at 'info m)))))

(def enter (m state)
  (puts m 'state state 'tics 0))

;;;; Thinking

; Every monster and animation thinks once a tic.  A thinker takes the world
; and a mobj and returns (world . mobj), with no mobj when it is gone; the
; world carries the random index, sounds, blasts and the player's health.
(def run-actors (w)
  (let (w2 . ms) (foldl (fn (m (w . acc))
                          (if (or (at 'info m) (in (at 'state m) 'anim 'die))
                              (let (w3 . m2) (think w m)
                                (cons w3 (if m2 (cons m2 acc) acc)))
                              (cons w (cons m acc))))
                        (cons w nil)
                        (at 'mobjs w))
    (run-blasts (puts w2 'mobjs (rev ms)))))

(def think (w m)
  (if (at 'info m)
      (think-monster w (puts m 'tics (+ 1 (at 'tics m))) (at 'info m))
      (withs (tics (+ 1 (at 'tics m))
              i    (floor (/ tics 3)))
        (if (< i (len (at 'frames m)))
            (cons w (puts m 'tics tics 'frame (nth (+ i 1) (at 'frames m))))
            (cons w nil)))))

(def think-monster (w m info)
  (let (hp speed pain-chance pain-frame death-frames attack sounds) info
    (case (at 'state m)
      idle   (let m (puts m 'frame (if (< (mod (at 'tic w) 16) 8) \A \B))
               (if (and (= (mod (at 'tic w) 4) (mod (at 'x m) 4)) (facing-player w m) (sees-player w m))
                   (cons (monster-sound w m 1) (enter m 'chase))
                   (cons w m)))
      chase  (chase w m speed attack)
      attack (attack-step w m attack)
      pain   (cons w (if (> (at 'tics m) 3) (enter m 'chase) m))
      die    (let i (floor (/ (at 'tics m) 4))
               (cons w (if (< i (len death-frames))
                           (puts m 'frame (nth (+ i 1) death-frames))
                           (enter m 'dead))))
             (cons w m))))

; Sight: in range, from the monster's eyes to ours, with no wall in between.
(def sees-player (w m)
  (and (> (at 'health w) 0)
       (< (abs (- (at 'x m) (at 'px w))) 1500)
       (< (abs (- (at 'y m) (at 'py w))) 1500)
       (clear-line (at 'grid (at 'lv w)) (at 'heights w)
                   (at 'x m) (at 'y m) (+ (car (nth (+ (at 'sec m) 1) (at 'heights w))) 42)
                   (at 'px w) (at 'py w) (eye-z w))))

; Like Doom's monsters, a sleeping one only notices us in front of it,
; unless we are close.
(def facing-player (w m)
  (with (dx (- (at 'px w) (at 'x m)) dy (- (at 'py w) (at 'y m)))
    (or (> (+ (* dx (cos (at 'angle m))) (* dy (sin (at 'angle m)))) 0)
        (< (+ (* dx dx) (* dy dy)) 4096))))

(def angle-to-player (w m)
  (atan2 (- (at 'py w) (at 'y m)) (- (at 'px w) (at 'x m))))

(def chase (w m speed attack)
  (withs (m    (puts m 'frame (nth (+ 1 (mod (floor (/ (at 'tics m) 4)) 4)) "ABCD"))
          d    (dist (at 'x m) (at 'y m) (at 'px w) (at 'py w))
          r    (random w)
          w    (spin w))
    (if (and (> (at 'health w) 0)
             (if (= (car attack) 'bite) (< d (+ (at 'radius m) 60)) (< r 7))
             (sees-player w m))
        (cons w (puts (enter m 'attack) 'angle (angle-to-player w m)))
        (> d (+ (at 'radius m) player-radius 8))
        (let a (angle-to-player w m)
          (cons w (or (step-toward w m a speed)
                      (step-toward w m (+ a 0.8) speed)
                      (step-toward w m (- a 0.8) speed)
                      (step-toward w m (+ a 1.6) speed)
                      (step-toward w m (- a 1.6) speed)
                      m)))
        (cons w m))))

(def step-toward (w m a speed)
  (withs (lv      (at 'lv w)
          heights (at 'heights w)
          x       (+ (at 'x m) (* speed (cos a)))
          y       (+ (at 'y m) (* speed (sin a)))
          sec     (point-sector (at 'root lv) x y)
          (ff fc) (nth (+ sec 1) heights)
          here    (car (nth (+ (at 'sec m) 1) heights)))
    (if (and (<= (abs (- ff here)) max-step)
             (>= (- fc ff) 56)
             (no (wall-near lv heights x y (at 'radius m) here))
             (> (dist x y (at 'px w) (at 'py w)) (+ (at 'radius m) player-radius)))
        (puts m 'x x 'y y 'angle a 'sec sec))))

; Is there a wall within r of (x, y) that something standing at height floor
; cannot pass?
(def wall-near (lv heights x y r floor)
  (some [let (x1 y1 x2 y2 front back blocking minx maxx miny maxy len2 . rest) _
          (and (or blocking (opening-blocks heights front back floor))
               (withs (dx (- x2 x1)
                       dy (- y2 y1)
                       f  (clamp (/ (+ (* (- x x1) dx) (* (- y y1) dy)) len2) 0 1)
                       cx (+ x1 (* f dx))
                       cy (+ y1 (* f dy)))
                 (< (+ (* (- x cx) (- x cx)) (* (- y cy) (- y cy))) (* r r))))]
        (lines-near (at 'grid lv) x y)))

; Too high a step up, or too little headroom, between two sectors.
(def opening-blocks (heights front back floor)
  (let ((ff fc) (bf bc)) (list (nth (+ front 1) heights) (nth (+ back 1) heights))
    (or (> (- (max ff bf) floor) max-step)
        (< (- (min fc bc) (max ff bf)) 56))))

(def attack-step (w m attack)
  (withs (frames (nth 5 attack)
          i      (floor (/ (- (at 'tics m) 1) 4)))
    (if (< i (len frames))
        (let m (puts m 'frame (nth (+ i 1) frames))
          (if (= (at 'tics m) (+ 1 (* 4 (- (len frames) 1))))
              (monster-fire w m attack)
              (cons w m)))
        (cons w (enter m 'chase)))))

(def monster-fire (w m attack)
  (withs ((kind shots unit dice frames) attack
          m (puts m 'angle (angle-to-player w m))
          w (monster-sound w m 4)
          d (dist (at 'x m) (at 'y m) (at 'px w) (at 'py w)))
    (cons (if (no (sees-player w m))
              w
              (= kind 'bite)
              (if (< d (+ (at 'radius m) 70))
                  (spin (hurt-player w (* unit (+ 1 (mod (random w) dice)))))
                  w)
              (volley w shots d unit dice))
          m)))

; Each shot hits less often the further away we are.
(def volley (w shots d unit dice)
  (if (> shots 0)
      (withs (hit (< (* 4 (random w)) (- 900 (/ d 3)))
              w   (spin w)
              w   (if hit (spin (hurt-player w (* unit (+ 1 (mod (random w) dice))))) w))
        (volley w (- shots 1) d unit dice))
      w))

;;;; Damage

(def damage (w m n)
  (let m (puts m 'hp (- (at 'hp m) n))
    (if (<= (at 'hp m) 0)
        (kill w m)
        (at 'info m)
        (withs (r (random w) w (spin w))
          (if (< r (caddr (at 'info m)))
              (cons (monster-sound w m 2) (puts (enter m 'pain) 'frame (nth 4 (at 'info m))))
              (= (at 'state m) 'idle)
              (cons w (enter m 'chase))
              (cons w m)))
        (cons w m))))

(def kill (w m)
  (let m (enter (puts m 'solid nil 'shootable nil) 'die)
    (if (at 'info m)
        (cons (monster-sound w m 3) m)
        (cons (puts (sound w "DSBAREXP")
                    'blasts (cons (list (at 'x m) (at 'y m) (+ (car (nth (+ (at 'sec m) 1) (at 'heights w))) 16))
                                  (at 'blasts w)))
              (puts m 'sprite "BEXP" 'frames "ABCDE" 'bright t 'frame \A 'state 'die)))))

; Damage the mobj with this id.
(def damage-id (w id n)
  (let (w2 . ms) (foldl (fn (m (w . acc))
                          (if (= (at 'id m) id)
                              (let (w3 . m2) (damage w m n) (cons w3 (cons m2 acc)))
                              (cons w (cons m acc))))
                        (cons w nil)
                        (at 'mobjs w))
    (puts w2 'mobjs (rev ms))))

; A barrel blast hurts everything within 128 units that it can see, the
; player included.  Barrels it sets off blast on the next tic.
(def run-blasts (w)
  (foldl (fn ((bx by bz) w)
           (withs (g  (at 'grid (at 'lv w))
                   d  (dist bx by (at 'px w) (at 'py w))
                   w  (if (and (< d 128) (clear-line g (at 'heights w) bx by bz (at 'px w) (at 'py w) (eye-z w)))
                          (hurt-player w (floor (- 128 d)))
                          w))
             (foldl (fn (m w)
                      (if (at 'shootable m)
                          (let d (dist bx by (at 'x m) (at 'y m))
                            (if (and (< d 128)
                                     (clear-line g (at 'heights w) bx by bz (at 'x m) (at 'y m)
                                                 (+ (car (nth (+ (at 'sec m) 1) (at 'heights w))) 28)))
                                (damage-id w (at 'id m) (floor (- 128 d)))
                                w))
                          w))
                    w
                    (at 'mobjs w))))
         (puts w 'blasts nil)
         (at 'blasts w)))

; Firing makes noise: idle monsters nearby wake up.
(def make-noise (w)
  (puts w 'mobjs (map [if (and (= (at 'state _) 'idle)
                               (< (abs (- (at 'x _) (at 'px w))) 1000)
                               (< (abs (- (at 'y _) (at 'py w))) 1000))
                          (enter _ 'chase)
                          _]
                      (at 'mobjs w))))
