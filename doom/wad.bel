; Doom in Bel: WAD files, palette, light, flats, patches, textures and
; sprites.  Everything is read once by doom-init into immutable lists.

;;;; WAD files

; Reading the file is the one place we touch a stream: a tail-recursive
; loop over rdc.
(def read-bytes (path)
  (let s (ops path 'in)
    (let bs (read-rest s nil)
      (cls s)
      bs)))

(def read-rest (s acc)
  (let c (rdc s)
    (if c (read-rest s (cons (charn c) acc)) (rev acc))))

(def u16 (bs) (+ (car bs) (* 256 (cadr bs))))

(def s16 (bs)
  (let n (u16 bs)
    (if (> n 32767) (- n 65536) n)))

(def s32 (bs) (+ (u16 bs) (* 65536 (s16 (cddr bs)))))

(def lump-name (bs)
  (sym (map nchar (keep [> _ 0] (first 8 bs)))))

; The directory as a list of (name bytes size), each lump's bytes cut from
; the file in one pass so parsing a lump never walks the rest of the file.
(def wad-lumps (bs)
  (cut-lumps bs (s32 (drop 4 bs)) (drop (s32 (drop 8 bs)) bs) bs 0 nil))

(def cut-lumps (bs n dir cur pos acc)
  (if (= n 0)
      (rev acc)
      (withs (off  (s32 dir)
              size (s32 (drop 4 dir))
              here (if (< off pos) (drop off bs) (drop (- off pos) cur)))
        (cut-lumps bs (- n 1) (drop 16 dir) here off
                   (cons (list (lump-name (drop 8 dir)) (first size here) size) acc)))))

(def lump (name lumps)
  (cadr (get name lumps)))

; The fixed-size records of a lump, each parsed by f.
(def records (name size f lumps)
  (let l (get name lumps)
    (map f (chunks (cadr l) size (/ (caddr l) size) nil))))

(def chunks (bs size n acc)
  (if (> n 0)
      (chunks (drop size bs) size (- n 1) (cons bs acc))
      (rev acc)))

;;;; Palette and light

(def palette-rgb (pal)
  (map [first 3 _] (chunks pal 3 256 nil)))

(def colormap-chars (bs)
  (map [map nchar (first 256 (drop (* 256 _) bs))] (iota 32)))

(def nearest-color (r g b rgb)
  (cadr (foldl (fn ((cr cg cb) (i best bestd))
                 (let d (+ (* (- r cr) (- r cr)) (* (- g cg) (- g cg)) (* (- b cb) (- b cb)))
                   (if (< d bestd)
                       (list (+ i 1) i d)
                       (list (+ i 1) best bestd))))
               (list 0 0 1000000)
               rgb)))

(def light-start (light)
  (* 4 (- 15 (clamp (floor (/ light 16)) 0 15))))

; A flat is 64 rows of 64 1-based palette indices.
(def flat (name lumps)
  (let bs (lump name lumps)
    (map [map inc (first 64 (drop (* 64 _) bs))] (iota 64))))

;;;; Patches and textures

; A patch is a list of columns of 1-based palette indices, 0 = transparent.
(def patch-raster (pb)
  (let h (u16 (cddr pb))
    (map [paint-posts (drop (s32 (drop (+ 8 (* 4 _)) pb)) pb) (fill h 0) h]
         (iota (u16 pb)))))

; Each post is (top-delta length pad pixels... pad), ended by 255.
(def paint-posts (p col h)
  (if (or (no p) (= (car p) 255))
      col
      (withs (top (car p)
              n   (cadr p)
              k   (max 0 (min n (- h top))))
        (paint-posts (drop (+ n 4) p)
                     (append (first top col) (map inc (first k (drop 3 p))) (drop (+ top k) col))
                     h))))

; A patch column moved down to start at row y of an h-row texture column.
(def placed (pcol y h)
  (first h (append (if (< y 0) (drop (- y) pcol) (fill y 0)) (if (< y 0) nil pcol) (fill h 0))))

; Lay one patch column over a texture column, starting at row y.
(def overlay (col pcol y)
  (map (fn (old new) (if (> new 0) new old)) col (placed pcol y (len col))))

; Texture: (width height columns masked-columns).  The masked columns keep
; 0 where no patch covers, for see-through middles; walls show black there.
(def load-textures (lumps)
  (with (pb (lump 'PNAMES lumps) tb (lump 'TEXTURE1 lumps))
    (let rasters (map [patch-raster (lump (lump-name (drop (+ 4 (* 8 _)) pb)) lumps)]
                      (iota (s32 pb)))
      (map [texture (drop (s32 (drop (+ 4 (* 4 _)) tb)) tb) rasters]
           (iota (s32 tb))))))

; Most texture columns lie under a single patch and are just that patch's
; column, moved; only where patches overlap do we merge texel by texel.
(def texture (b rasters)
  (withs (w       (s16 (drop 12 b))
          h       (s16 (drop 14 b))
          patches (map [let p (drop (+ 22 (* 10 _)) b)
                         (list (s16 p) (s16 (cddr p)) (nth (+ 1 (u16 (drop 4 p))) rasters))]
                       (iota (s16 (drop 20 b))))
          masked  (map (fn (x)
                         (let over (keep [let (ox oy raster) _
                                           (and (>= x ox) (< x (+ ox (len raster))))]
                                         patches)
                           (if (no over)
                               (fill h 0)
                               (no (cdr over))
                               (let (ox oy raster) (car over)
                                 (placed (nth (+ 1 (- x ox)) raster) oy h))
                               (foldl (fn ((ox oy raster) col)
                                        (overlay col (nth (+ 1 (- x ox)) raster) oy))
                                      (fill h 0)
                                      over))))
                       (iota w)))
    (list (lump-name b) w h (map [if (mem 0 _) (map [max _ 1] _) _] masked) masked)))

;;;; Pictures and sprites

; A picture is (width height left-offset top-offset columns).
(def picture (pb)
  (list (u16 pb) (u16 (cddr pb)) (s16 (drop 4 pb)) (s16 (drop 6 pb)) (patch-raster pb)))

(def sprite-lumps (lumps)
  (let ls (drop (pos 'S_START (map car lumps)) lumps)
    (first (- (pos 'S_END (map car ls)) 1) ls)))

; Sprite lumps are named like TROOA1 or TROOA2A8: four letters of sprite, a
; frame letter and a rotation (0 means it looks the same from every side),
; then optionally a second frame and rotation that use the picture mirrored.
; The result maps a sprite frame like TROOA to its eight rotations, each
; (lump . flipped).
(def sprite-frames (names)
  (let views (apply append (map sprite-views names))
    (map (fn (key)
           (cons key (map (fn (r)
                            (let v (find [and (id (car _) key) (in (cadr _) 0 r)] views)
                              (if v (cddr v))))
                          '(1 2 3 4 5 6 7 8))))
         (dedup (map car views)))))

(def sprite-views (name)
  (let cs (nom name)
    (cons (list (sym (first 5 cs)) (- (charn (nth 6 cs)) 48) name)
          (if (> (len cs) 6)
              (list (cons (sym (snoc (first 4 cs) (nth 7 cs)))
                          (cons (- (charn (nth 8 cs)) 48) (cons name t))))))))
