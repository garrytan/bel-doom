; Doom in Bel: the renderer.  (render w) is a function from the world to a
; frame: a list of columns, one per screen column, each a list of chars,
; one per screen row.
;
; Walls are drawn front to back by walking the BSP tree.  The state threaded
; through the walk is (columns planes masked seen):
;
;   columns  a tree over the screen columns (see make-tree); each column is
;            (top bottom tops bottoms clips): rows top to bottom are still
;            open; tops and bottoms are the runs drawn so far above and below
;            them, newest first; clips records (1/z top bottom) each time a
;            wall narrowed the column, for clipping sprites later.  The walk
;            stops once every column is closed.
;   planes   floor and ceiling tables computed so far, by (start height)
;   masked   see-through middle textures to draw with the sprites
;   seen     sectors drawn, whose things may be visible

;;;; The screen

; The screen record, built once by doom-init from the requested size:
;
;   (width height view-h half-w half-h focal-x focal-y xmap ymap)
;
; view-h   rows of 3D view; the status bar takes the rest, 16% of the
;          height (rounded), as in Doom
; focal-x  width/2: a 90 degree field of view across the width
; focal-y  4/5 of the height.  Doom draws 320x200 with one focal length,
;          160, on both axes, and a 4:3 monitor shows each pixel 1.2 times
;          taller than wide.  Keeping that picture on square pixels means
;          focal-y = focal-x * (height/width) * 4/3 * 1.2, which is 4/5 of
;          the height.  At 160x100 and 320x200 it equals focal-x exactly.
; xmap     for each screen column, the column of Doom's 320x200 screen it
;          shows: floor(x * 320 / width)
; ymap     for each screen row, the row of Doom's 320x200 screen it shows.
;          View rows map onto Doom's 168 view rows, floor(y * 168 / view-h);
;          status bar rows onto its 32 bar rows,
;          168 + floor((y - view-h) * 32 / (height - view-h)), so the bar
;          exactly fills its rows at any height (77 rows at 640x480).
;
; Pictures (weapon, status bar, face, numbers) and the sky are sampled
; through these nearest-neighbour maps, so any scale works, whole or not.
(def make-screen (width height)
  (let view-h (- height (round (/ (* 16 height) 100)))
    (list width height view-h (/ width 2) (/ view-h 2) (/ width 2) (/ (* 4 height) 5)
          (map [floor (/ (* _ 320) width)] (iota width))
          (append (map [floor (/ (* _ 168) view-h)] (iota view-h))
                  (map [+ 168 (floor (/ (* _ 32) (- height view-h)))] (iota (- height view-h)))))))

(def render (w)
  (render-slice w 0 (- (car (at 'screen w)) 1)))

; The frame's columns x0..x1.  The walk over the BSP is always full width,
; so what is visible (sectors seen, which sprites, their order with the
; see-through middles) does not depend on the slice, but only the slice's
; columns record what to draw, and only they are drawn.  Each column is
; built once: its runs top to bottom onto one reversed list, then that list
; onto the column's status bar.
(def render-slice (w x0 x1)
  (withs (lv     (at 'lv w)
          scr    (at 'screen w)
          (width height view-h . srest) scr
          angle  (at 'pangle w)
          vcos   (cos angle)
          vsin   (sin angle)
          px     (at 'px w)
          py     (at 'py w)
          v      (list px py (eye-z w) vcos vsin (at 'heights w) lv angle
                       (sky-columns lv angle) (view-rays scr vcos vsin) scr x0 x1)
          st     (render-node (at 'root lv) v
                              (list (make-tree 0 (- width 1) (list 0 (- view-h 1) nil nil nil))
                                    nil nil nil))
          n      (- x1 x0 -1)
          recs   (rev (tree-leaves (car st) 0 (- width 1) x0 x1 nil))
          tab    (if (> (at 'pain-tics w) 0)  (at 'pain-table lv)
                     (> (at 'bonus-tics w) 0) (at 'bonus-table lv))
          ovls   (weapon-runs w v (thing-runs w v (fill n nil) (map [nth 5 _] recs) (nth 3 st) (nth 4 st))))
    (map (fn (c hud ovl) (build-column c hud ovl px py tab view-h))
         recs
         (first n (drop x0 (cdr (at 'hud w))))
         ovls)))

(def eye-z (w)
  (+ (at 'pfloor w)
     (if (> (at 'health w) 0)
         view-height
         (max 10 (- view-height (* 3 (at 'dead-tics w)))))))

; A column: the runs above its open rows, top first, black for any rows
; never drawn, then the runs below, onto a reversed list (bottom row
; first).  That list then goes onto the status bar's rows, bottom first, so
; the column comes out top first, through the tint table if any.  Sprites,
; see-through middles and the weapon arrive as overlay runs (nearest
; first), also bottom first, and replace the rows they cover wherever they
; are not transparent, during that same last pass.
(def build-column (c hud ovl px py tab view-h)
  (let (top bot tops bots clips) c
    (let racc (foldl (fn (d acc) (paint d acc px py))
                     (fill-onto (- bot top -1) (nchar 0)
                                (foldl (fn (d acc) (paint d acc px py)) nil (rev tops)))
                     bots)
      (if ovl
          (withs ((ny nn nts)  (car ovl)
                  nh           (+ ny nn -1)
                  (fy fh fts)  (if (cdr ovl) (combine-runs (cdr ovl)) (list view-h -1 nil))
                  lo           (min ny fy)
                  hi           (max nh fh)
                  below        (- view-h 1 hi)
                  n            (- hi lo -1))
            (onto (drop (+ below n) racc)
                  (merge-onto n hi (drop below racc) ny nh nts fy fh fts
                              (onto-n below racc hud tab) tab)
                  tab))
          (onto racc hud tab)))))

; xs, which are reversed, onto acc, through the tint table if any.
(def onto (xs acc tab)
  (if tab
      (foldl (fn (ch acc) (cons (nth (+ 1 (charn ch)) tab) acc)) acc xs)
      (foldl cons acc xs)))

(def onto-n (n xs acc tab)
  (if (> n 0)
      (onto-n (- n 1) (cdr xs) (cons (tinted (car xs) tab) acc) tab)
      acc))

; n rows of xs from row y up onto acc, each replaced by the pixel of the
; near run (rows ny..nh, pixels nts) or else of the far run (fy..fh, fts)
; where they cover it and are not transparent.
(def merge-onto (n y xs ny nh nts fy fh fts acc tab)
  (if (> n 0)
      (with (in-near (<= ny y nh) in-far (<= fy y fh))
        (merge-onto (- n 1) (- y 1) (cdr xs)
                    ny nh (if in-near (cdr nts) nts)
                    fy fh (if in-far (cdr fts) fts)
                    (cons (tinted (or (and in-near (car nts)) (and in-far (car fts)) (car xs)) tab) acc)
                    tab))
      acc))

(def tinted (ch tab)
  (if tab (nth (+ 1 (charn ch)) tab) ch))

; Overlay runs (top-row rows pixels), pixels bottom first and nil where
; transparent, nearest first, as one run (top bottom pixels) where nearer
; runs cover farther ones.  Columns with more than two runs use this for
; all but the nearest.
(def combine-runs (runs)
  (withs (lo (apply min (map car runs))
          hi (apply max (map [+ (car _) (cadr _) -1] runs)))
    (list lo hi
          (if (no (cdr runs))
              (caddr (car runs))
              (foldl (fn ((ya n texels) acc)
                       (let off (- hi (+ ya n -1))
                         (append (first off acc)
                                 (map (fn (near far) (or near far)) texels (drop off acc))
                                 (drop (+ off n) acc))))
                     (fill (- hi lo -1) nil)
                     (rev runs))))))

(def fill-onto (n x acc)
  (if (> n 0) (fill-onto (- n 1) x (cons x acc)) acc))

; A run is (kind rows . details):
;   (wall n v step texture-column height colormap)
;   (flat n plane-table-from-its-first-row flat . ray)
;   (sky n sky-column-from-its-first-row)
;   (black n)
; paint conses its pixels, top first, onto acc.
(def paint (d acc px py)
  (let (kind n . args) d
    (case kind
      wall (let (v step tc h cm) args (wall-run n v step tc h cm acc))
      flat (let (zt rows . ray) args (flat-run zt n rows (car ray) (cdr ray) px py acc))
      sky  (foldl cons acc (first n (car args)))
           (fill-onto n (nchar 0) acc))))

;;;; The column tree

; The walk narrows ranges of columns, so the columns live in a balanced
; tree: a seg replaces only the leaves it covers and the nodes above them,
; and asks whether any of its columns are open without visiting closed
; subtrees.  A leaf is a column; a node is (node closed left right), with
; the number of closed columns under it.  Positions are not stored: lo..hi
; is passed down, split at the middle.
(def make-tree (lo hi leaf)
  (if (= lo hi)
      leaf
      (let mid (floor (/ (+ lo hi) 2))
        (list 'node 0 (make-tree lo mid leaf) (make-tree (+ mid 1) hi leaf)))))

(def closed (tr lo hi)
  (if (= lo hi)
      (if (> (car tr) (cadr tr)) 1 0)
      (cadr tr)))

; Is some column in xa..xb still open?
(def tree-open (tr lo hi xa xb)
  (and (<= xa hi)
       (>= xb lo)
       (< (closed tr lo hi) (- hi lo -1))
       (or (= lo hi)
           (let mid (floor (/ (+ lo hi) 2))
             (or (tree-open (caddr tr) lo mid xa xb)
                 (tree-open (nth 4 tr) (+ mid 1) hi xa xb))))))

; Replace each leaf c at x in xa..xb, left to right, by the leaf of
; (f c x state), which returns (leaf . state).  A closed subtree is kept as
; it is, and skip moves the state over its columns.  Returns (tree . state).
(def tree-update (tr lo hi xa xb f skip state)
  (if (or (> xa hi) (< xb lo))
      (cons tr state)
      (= (closed tr lo hi) (- hi lo -1))
      (cons tr (skip state (- (min hi xb) (max lo xa) -1)))
      (= lo hi)
      (f tr lo state)
      (withs (mid       (floor (/ (+ lo hi) 2))
              (l . st1) (tree-update (caddr tr) lo mid xa xb f skip state)
              (r . st2) (tree-update (nth 4 tr) (+ mid 1) hi xa xb f skip st1))
        (cons (list 'node (+ (closed l lo mid) (closed r (+ mid 1) hi)) l r) st2))))

; The leaves for columns x0..x1, consed right to left onto acc, so the
; result reads right to left.
(def tree-leaves (tr lo hi x0 x1 acc)
  (if (or (> x0 hi) (< x1 lo))
      acc
      (= lo hi)
      (cons tr acc)
      (let mid (floor (/ (+ lo hi) 2))
        (tree-leaves (nth 4 tr) (+ mid 1) hi x0 x1 (tree-leaves (caddr tr) lo mid x0 x1 acc)))))

;;;; The BSP walk

(def render-node (n v st)
  (if (let w (car (nth 11 v)) (= (closed (car st) 0 (- w 1)) w))
      st
      (= (car n) 'sub)
      (foldl (fn (sg st) (render-seg sg v st)) st (cadr n))
      (let ((tag x y dx dy rbox lbox right left) (px py . rest)) (list n v)
        (if (> (* dy (- px x)) (* dx (- py y)))
            (let st (render-node right v st)
              (if (box-visible lbox v (car st)) (render-node left v st) st))
            (let st (render-node left v st)
              (if (box-visible rbox v (car st)) (render-node right v st) st))))))

; Could anything in this node's bounding box still be visible?
(def box-visible (box v cols)
  (let ((top bot left right) (px py vz vcos vsin heights lv angle skycols rays scr . vrest)) (list box v)
    (or (and (<= left px right) (<= bot py top))
        (let corners (map (fn ((x y))
                            (with (dx (- x px) dy (- y py))
                              (list (+ (* dx vcos) (* dy vsin)) (- (* dx vsin) (* dy vcos)))))
                          (list (list left top) (list right top)
                                (list left bot) (list right bot)))
          (if (or (all [> (cadr _) (car _)] corners)
                  (all [< (cadr _) (- (car _))] corners)
                  (all [< (car _) near] corners))
              nil
              (some [< (car _) near] corners)
              t
              (let (width height view-h half-w half-h focal-x . srest) scr
                (let xs (map [+ half-w (/ (* (cadr _) focal-x) (car _))] corners)
                  (tree-open cols 0 (- width 1)
                             (max 0 (floor (apply min xs)))
                             (min (- width 1) (floor (apply max xs)))))))))))

; Transform a seg into view space, clip it to the near plane, project it,
; and draw its visible columns.
(def render-seg (sg v st)
  (let ((x1 y1 x2 y2 slen uoff . rest) (px py vz vcos vsin . vrest)) (list sg v)
    (if (< (* (- x2 x1) (- py y1)) (* (- y2 y1) (- px x1)))
        (withs (ax (- x1 px) ay (- y1 py) bx (- x2 px) by (- y2 py)
                z1 (+ (* ax vcos) (* ay vsin))
                s1 (- (* ax vsin) (* ay vcos))
                z2 (+ (* bx vcos) (* by vsin))
                s2 (- (* bx vsin) (* by vcos)))
          (if (and (< z1 near) (< z2 near))
              st
              (< z1 near)
              (let f (/ (- near z1) (- z2 z1))
                (project sg v st (+ s1 (* f (- s2 s1))) near (+ uoff (* f slen)) s2 z2 (+ uoff slen)))
              (< z2 near)
              (let f (/ (- near z2) (- z1 z2))
                (project sg v st s1 z1 uoff (+ s2 (* f (- s1 s2))) near (- (+ uoff slen) (* f slen))))
              (project sg v st s1 z1 uoff s2 z2 (+ uoff slen))))
        st)))

(def project (sg v st s1 z1 u1 s2 z2 u2)
  (withs ((width height view-h half-w half-h focal-x . srest) (nth 11 v)
          sx1 (+ half-w (/ (* s1 focal-x) z1))
          sx2 (+ half-w (/ (* s2 focal-x) z2))
          xa  (max 0 (ceil (- sx1 0.5)))
          xb  (min (- width 1) (- (ceil (- sx2 0.5)) 1)))
    (if (and (< sx1 sx2) (<= xa xb) (tree-open (car st) 0 (- width 1) xa xb))
        (withs (iz1 (/ 1 z1)
                iz2 (/ 1 z2)
                diz (/ (- iz2 iz1) (- sx2 sx1))
                duz (/ (- (* u2 iz2) (* u1 iz1)) (- sx2 sx1))
                dx  (- (+ xa 0.5) sx1))
          (draw-seg sg v st xa xb (+ iz1 (* dx diz)) (+ (* u1 iz1) (* dx duz)) diz duz))
        st)))

;;;; Walls, floors and ceilings

; Distance to a floor or ceiling is constant along a screen row, and so is
; its light, so a plane gets a table of (distance . colormap) per row.
(def plane-table (start h cmaps scr)
  (let ((width height view-h half-w half-h focal-x focal-y . srest) h) (list scr (max h 1))
    (map [let z (/ (* h focal-y) (max (abs (- half-h _ 0.5)) 0.5))
           (cons z (nth (+ 1 (clamp (floor (- start (/ 1280 z))) 0 31)) cmaps))]
         (iota view-h))))

(def with-plane (planes start h cmaps scr)
  (if (get (list start h) planes)
      planes
      (cons (cons (list start h) (plane-table start h cmaps scr)) planes)))

(def plane (planes start h)
  (cdr (get (list start h) planes)))

; Pixels of a floor or ceiling along the view ray (rx, ry), from the
; row whose (distance . colormap) heads zt: the row's distance gives the
; point on the plane, its low six bits the texel.
(def flat-run (zt n rows rx ry px py acc)
  (if (> n 0)
      (flat-run (cdr zt) (- n 1) rows rx ry px py
                (cons (nth (nth (+ 1 (mod (floor (+ px (* (car (car zt)) rx))) 64))
                                (nth (+ 1 (mod (floor (- 0 py (* (car (car zt)) ry))) 64)) rows))
                           (cdr (car zt)))
                      acc))
      acc))

; The run for n rows of a wall from row ya.  v is the texture row at the
; center of row ya; it grows by step (map units per pixel) down the column.
(def wall-span (tex n ya u ttop step cm half-h)
  (if (no tex)
      (list 'black n)
      (let (w h cols . rest) tex
        (list 'wall n (mod (- ttop (* (- half-h ya 0.5) step)) h) step
              (nth (+ 1 (mod (floor u) w)) cols) h cm))))

(def wall-run (n v step tc h cm acc)
  (if (> n 0)
      (wall-run (- n 1) (+ v step) step tc h cm (cons (nth (nth (+ 1 (mod (floor v) h)) tc) cm) acc))
      acc))

; Draw a seg's columns xa..xb: for each, the ceiling above it, the floor
; below it, and its wall pieces, narrowing the column's open rows.  Only
; columns in the slice record their runs and sprite clips; the others just
; narrow, which is all the walk needs.
(def draw-seg (sg v st xa xb iz uz diz duz)
  (withs ((x1 y1 x2 y2 slen uoff yoff fi bi peg-top peg-bottom fake upper mid lower) sg
          (px py vz vcos vsin heights lv angle skycols rays scr x0 x1) v
          (width height view-h half-w half-h focal-x focal-y . srest) scr
          (cols planes masked seen) st
          sectors (at 'sectors lv)
          cmaps   (at 'colormaps lv)
          (ff fc) (nth (+ fi 1) heights)
          (light fsky frows crows . frest) (nth (+ fi 1) sectors)
          (bf bc) (if bi (nth (+ bi 1) heights) '(0 0))
          bsky    (and bi (cadr (nth (+ bi 1) sectors)))
          start   (light-start light)
          planes  (with-plane (with-plane planes start (- vz ff) cmaps scr) start (- fc vz) cmaps scr)
          ftab    (plane planes start (- vz ff))
          ctab    (plane planes start (- fc vz))
          fh      (- ff vz)
          bfh     (- bf vz)
          bch     (- bc vz)
          ch      (if (and bi fsky bsky) bch (- fc vz))
          wstart  (light-start (+ light (* 16 fake)))
          ttop    (if bi
                      (if upper (if peg-top (- fc vz) (+ bch (cadr upper))))
                      (if mid (if peg-bottom (+ fh (cadr mid)) (- fc vz))))
          btop    (if (and bi lower) (if peg-bottom (- fc vz) bfh))
          mtop    (if (and bi mid)
                      (+ yoff (if peg-bottom (+ (max fh bfh) (cadr mid)) (min (- fc vz) bch))))
          fence   (and bi mid)
          (new iz2 uz2 mcols)
          (tree-update
            cols 0 (- width 1) xa xb
            (fn (c x (iz uz ms))
              (withs (skycol (nth (+ x 1) skycols)
                      ray    (nth (+ x 1) rays)
                      (rec . m)
                      (let r (let (top bot tops bots clips) c
                           (if (> top bot)
                               (if fence (cons c nil) c)
                               (withs (z       (/ 1 iz)
                                       u       (* uz z)
                                       k       (* focal-y iz)
                                       step    (/ z focal-y)
                                       cm      (nth (+ 1 (clamp (floor (- wstart (min (* 1280 iz) 23))) 0 31))
                                                    cmaps)
                                       yt      (ceil (- half-h (* ch k) 0.5))
                                       yb      (- (ceil (- half-h (* fh k) 0.5)) 1)
                                       top1    (max top (min yt (+ bot 1)))
                                       bot1    (min bot (max yb (- top1 1)))
                                       in      (<= x0 x x1)
                                       tops1   (if (and in (> top1 top))
                                                   (cons (if fsky
                                                             (list 'sky (- top1 top) (drop top skycol))
                                                             (cons 'flat (cons (- top1 top) (cons (drop top ctab) (cons crows ray)))))
                                                         tops)
                                                   tops)
                                       bots1   (if (and in (> bot bot1))
                                                   (cons (cons 'flat (cons (- bot bot1) (cons (drop (+ bot1 1) ftab) (cons frows ray))))
                                                         bots)
                                                   bots))
                                 (if bi
                                     (withs (ybc  (ceil (- half-h (* bch k) 0.5))
                                             ybf  (- (ceil (- half-h (* bfh k) 0.5)) 1)
                                             top2 (if (< bch ch) (max top1 (min ybc (+ bot1 1))) top1)
                                             bot2 (if (> bfh fh) (min bot1 (max ybf (- top2 1))) bot1))
                                       ((if fence
                                            (fn (rec) (cons rec (if (<= top2 bot2) (list x iz u top2 bot2 cm))))
                                            idfn)
                                             (list top2
                                                   bot2
                                                   (if (and in (> top2 top1))
                                                       (cons (wall-span upper (- top2 top1) top1 u
                                                                        (+ ttop yoff) step cm half-h)
                                                             tops1)
                                                       tops1)
                                                   (if (and in (> bot1 bot2))
                                                       (cons (wall-span lower (- bot1 bot2) (+ bot2 1) u
                                                                        (+ btop yoff) step cm half-h)
                                                             bots1)
                                                       bots1)
                                                   (if (and in (or (> top2 top) (< bot2 bot)))
                                                       (cons (list iz top2 bot2) clips)
                                                       clips))))
                                     (list (+ bot1 1)
                                                 bot1
                                                 (if (and in (>= bot1 top1))
                                                     (cons (wall-span mid (- bot1 top1 -1) top1 u
                                                                      (+ ttop yoff) step cm half-h)
                                                           tops1)
                                                     tops1)
                                                 bots1
                                                 (if in (cons (list iz view-h -1) clips) clips))))))
                        (if fence r (cons r nil))))
                (cons rec (list (+ iz diz) (+ uz duz) (if m (cons m ms) ms)))))
            (fn ((iz uz ms) k) (list (add-n iz diz k) (add-n uz duz k) ms))
            (list iz uz nil)))
    (list new
          planes
          (if mcols
              (cons (list (/ 1 (cadr (nth (+ 1 (floor (/ (len mcols) 2))) mcols)))
                          'masked
                          (list (rev mcols) mid mtop))
                    masked)
              masked)
          (adjoin fi seen))))

; x after adding dx to it k times, as the columns' 1/z and u advance.
(def add-n (x dx k)
  (if (> k 0) (add-n (+ x dx) dx (- k 1)) x))

(def iota-from (n x)
  (steps n x 1))

; The sky column for each screen column, by view angle.
(def sky-columns (lv angle)
  (map [nth (+ 1 (mod (floor (* (+ angle _) (/ 512 pi))) 256)) (at 'sky-tables lv)]
       (at 'xangles lv)))

(def view-rays (scr vcos vsin)
  (let (width height view-h half-w half-h focal-x . srest) scr
    (map [let k (/ (- (+ _ 0.5) half-w) focal-x)
           (cons (+ vcos (* k vsin)) (- vsin (* k vcos)))]
         (iota width))))

;;;; Sprites

; Things in sectors we drew, and see-through middles, far to near, as
; overlay runs added to the slice's columns.  A sprite column at depth z is
; clipped by the newest wall nearer than z in that column's clip records.
(def thing-runs (w v ovls clips masked seen)
  (foldl (fn ((z s m) ovls)
           (if (= s 'masked)
               (let (mcols tex mtop) m (masked-runs ovls v mcols tex mtop))
               (sprite-runs ovls clips w v m z s)))
         ovls
         (sort (fn (a b) (> (car a) (car b)))
               (append masked
                       (keep idfn (map [sprite-item _ v]
                                       (keep [mem (at 'sec _) seen] (at 'mobjs w))))))))

(def sprite-item (m v)
  (withs ((px py vz vcos vsin . rest) v
          dx (- (at 'x m) px)
          dy (- (at 'y m) py)
          z  (+ (* dx vcos) (* dy vsin))
          s  (- (* dx vsin) (* dy vcos)))
    (if (and (> z 4) (< (abs s) (+ z 64)))
        (list z s m))))

; The frame a thing shows: its own, or a looping animation by the clock.
(def thing-frame (m tic)
  (or (at 'frame m)
      (let frames (at 'frames m)
        (nth (+ 1 (mod (floor (/ tic 4)) (len frames))) frames))))

; Which of the eight rotations faces us: 1 is the front.
(def sprite-rotation (m px py)
  (mod (floor (/ (+ (- (atan2 (- (at 'y m) py) (- (at 'x m) px)) (at 'angle m)) (* pi 1.125))
                 (* pi 0.25)))
       8))

(def sprite-runs (ovls clips w v m z s)
  (withs ((px py vz vcos vsin heights lv angle skycols rays scr x0 x1) v
          (width height view-h half-w half-h focal-x focal-y . srest) scr
          rots (cdr (get (sym (snoc (at 'sprite m) (thing-frame m (at 'tic w))))
                         (at 'sprite-frames lv))))
    (if (no rots)
        ovls
        (withs ((name . flip)     (or (nth (+ 1 (if (id (car rots) (cadr rots)) 0 (sprite-rotation m px py)))
                                           rots)
                                      (car rots))
                (pw ph lo to pcols) (cdr (get name (at 'pictures lv)))
                si     (at 'sec m)
                (flo cei) (nth (+ si 1) heights)
                mz     (or (at 'z m) (if (= (at 'class m) 'hanging) (- cei to) flo))
                xscale (/ focal-x z)
                xstep  (/ z focal-x)
                yscale (/ focal-y z)
                ystep  (/ z focal-y)
                iz     (/ 1 z)
                x1s    (+ half-w (* (- s lo) xscale))
                xa     (max x0 (ceil (- x1s 0.5)))
                xb     (min x1 (- (ceil (- (+ x1s (* pw xscale)) 0.5)) 1))
                ytop   (- half-h (* (- (+ mz to) vz) yscale))
                ya0    (ceil (- ytop 0.5))
                yb0    (- (ceil (- (+ ytop (* ph yscale)) 0.5)) 1)
                cmaps  (at 'colormaps lv)
                cm     (if (at 'bright m)
                           (car cmaps)
                           (nth (+ 1 (clamp (floor (- (light-start (car (nth (+ si 1) (at 'sectors lv))))
                                                      (min (* 1280 iz) 23)))
                                            0 31))
                                cmaps)))
          (if (> xa xb)
              ovls
              (add-runs
                ovls (- xa x0)
                (fn (x evs)
                  (withs (tx        (clamp (floor (* (- (+ x 0.5) x1s) xstep)) 0 (- pw 1))
                          ev        (find [> (car _) iz] evs)
                          (top bot) (if ev (cdr ev) (list 0 (- view-h 1)))
                          ya        (max ya0 top)
                          yb        (min yb0 bot))
                    (if (<= ya yb)
                        (list ya (- yb ya -1)
                              (sprite-texels (- yb ya -1) (* (- (+ ya 0.5) ytop) ystep) ystep
                                             (nth (+ 1 (if flip (- pw 1 tx) tx)) pcols) cm nil)))))
                (iota-from (- xb xa -1) xa)
                (first (- xb xa -1) (drop (- xa x0) clips))))))))

; Texels of a sprite column top to bottom, consed bottom first onto acc;
; nil where the sprite is transparent.
(def sprite-texels (n v step pcol cm acc)
  (if (> n 0)
      (sprite-texels (- n 1) (+ v step) step pcol cm
                     (cons (let c (car (drop (floor v) pcol))
                             (if (and c (> c 0)) (nth c cm)))
                           acc))
      acc))

; Each column's overlay list from column ia on, with the run f makes from
; that column's elements of lists added, when f makes one.
(def add-runs (ovls ia f . lists)
  (let n (len (car lists))
    (append (first ia ovls)
            (apply map (fn (l . args) (let r (apply f args) (if r (cons r l) l)))
                   (first n (drop ia ovls))
                   lists)
            (drop (+ ia n) ovls))))

; The see-through middle texture of a two-sided line (grates, fences),
; drawn once between floor and ceiling.  Each column was recorded as
; (x 1/z u top bottom colormap), in order of x.
(def masked-runs (ovls v mcols tex mtop)
  (withs ((w h walls masked) tex
          (px py vz vcos vsin heights lv angle skycols rays scr x0 x1) v
          (width height view-h half-w half-h focal-x focal-y . srest) scr
          ms (keep [<= x0 (car _) x1] mcols))
    (if (no ms)
        ovls
        (add-runs
          ovls (- (car (car ms)) x0)
          (fn (m)
            (if m
                (let (x iz u top bot cm) m
                  (withs (k    (* focal-y iz)
                          ytop (- half-h (* mtop k))
                          ya   (max top (ceil (- ytop 0.5)))
                          yb   (min bot (- (ceil (- (+ ytop (* h k)) 0.5)) 1)))
                    (if (<= ya yb)
                        (list ya (- yb ya -1)
                              (sprite-texels (- yb ya -1) (/ (- (+ ya 0.5) ytop) k) (/ 1 k)
                                             (nth (+ 1 (mod (floor u) w)) masked) cm nil)))))))
          (align (car (car ms)) (car (last ms)) ms nil)))))

; For each x from x to xb, the entry of ms (in order of x) for that x, or nil.
(def align (x xb ms acc)
  (if (> x xb)
      (rev acc)
      (and ms (= (car (car ms)) x))
      (align (+ x 1) xb (cdr ms) (cons (car ms) acc))
      (align (+ x 1) xb ms (cons nil acc))))

;;;; Pictures: the weapon and the status bar

; Draw a picture placed at Doom's 320x200 screen coordinates, sampled
; through the screen's maps, over screen rows ya..yb, onto the columns of
; screen columns x0..x1, whose first row is row0: the status bar, which is
; only redrawn when it changes.
(def draw-picture (cols lv name x y cm ya yb row0 scr x0 x1 tab)
  (withs ((w h lo to pcols) (cdr (get name (at 'pictures lv)))
          (width height view-h half-w half-h focal-x focal-y xmap ymap) scr
          left (floor (- x lo))
          top  (floor (- y to))
          xs   (keep [<= left (nth (+ _ 1) xmap) (+ left w -1)] (iota-from (- x1 x0 -1) x0))
          ys   (keep [<= top (nth (+ _ 1) ymap) (+ top h -1)] (iota-from (- yb ya -1) ya))
          src  (map [- (nth (+ _ 1) ymap) top] ys)
          r0   (if ys (- (car ys) row0)))
    (if (and xs ys)
        (update-columns cols (- (car xs) x0)
          (fn (col sx)
            (overlay-run col r0 (len ys)
                     (picture-run src (nth (+ 1 (- (nth (+ sx 1) xmap) left)) pcols) cm tab
                                  (drop r0 col) nil)))
          xs)
        cols)))

; col with its n rows from row ya replaced by the run racc, bottom first.
(def overlay-run (col ya n racc)
  (append (first ya col) (foldl cons (drop (+ ya n) col) racc)))

; Columns xa onward replaced by f of each column and the elements of lists.
(def update-columns (cols xa f . lists)
  (let n (len (car lists))
    (append (first xa cols)
            (apply map f (first n (drop xa cols)) lists)
            (drop (+ xa n) cols))))

(def picture-run (src pcol cm tab bg acc)
  (if src
      (picture-run (cdr src) pcol cm tab (cdr bg)
                   (cons (let c (nth (+ (car src) 1) pcol)
                           (if (> c 0) (tinted (nth c cm) tab) (car bg)))
                         acc))
      acc))

(set pistol-frames (map [cons _ (sym (list \P \I \S \G _ \0))] "ABC"))

(def weapon-runs (w v ovls)
  (if (> (at 'health w) 0)
      (withs ((px py vz vcos vsin heights lv angle skycols rays scr x0 x1) v
              vh    (caddr scr)
              wt    (at 'wtics w)
              frame (if (> wt 9) \B (> wt 5) \C (> wt 2) \B \A)
              phase (* (at 'tic w) 0.2)
              bob   (at 'bob w)
              bx    (if (> wt 0) 0 (* bob 6 (cos phase)))
              by    (if (> wt 0) 0 (* bob 4 (abs (sin phase))))
              cmaps (at 'colormaps lv)
              cm    (nth (+ 1 (clamp (- (light-start (car (nth (+ 1 (at 'psec w)) (at 'sectors lv)))) 23)
                                     0 31))
                         cmaps)
              flash (if (> wt 9)
                        (picture-runs ovls lv 'PISFA0 (+ 1 bx) (+ 16 by) (car cmaps) (- vh 1) scr x0 x1)
                        ovls))
        (picture-runs flash lv (cdr (get frame pistol-frames)) (+ 1 bx) (+ 16 by) cm (- vh 1) scr x0 x1))
      ovls))

; A picture placed at Doom's 320x200 screen coordinates, sampled through
; the screen's maps over view rows 0..yb, as overlay runs.
(def picture-runs (ovls lv name x y cm yb scr x0 x1)
  (withs ((w h lo to pcols) (cdr (get name (at 'pictures lv)))
          (width height view-h half-w half-h focal-x focal-y xmap ymap) scr
          left (floor (- x lo))
          top  (floor (- y to))
          xs   (keep [<= left (nth (+ _ 1) xmap) (+ left w -1)] (iota-from (- x1 x0 -1) x0))
          ys   (keep [<= top (nth (+ _ 1) ymap) (+ top h -1)] (iota-from (+ yb 1) 0))
          src  (map [- (nth (+ _ 1) ymap) top] ys))
    (if (and xs ys)
        (add-runs ovls (- (car xs) x0)
          (fn (sx)
            (list (car ys) (len ys)
                  (picture-texels src (nth (+ 1 (- (nth (+ sx 1) xmap) left)) pcols) cm nil)))
          xs)
        ovls)))

(def picture-texels (src pcol cm acc)
  (if src
      (picture-texels (cdr src) pcol cm (cons (let c (nth (+ (car src) 1) pcol) (if (> c 0) (nth c cm))) acc))
      acc))

; Doom flashes the palette red when you are hurt and gold when you pick
; something up.  We have one palette, so we remap the view through a table
; of the nearest colors to each color blended toward red or gold.
(def tint-table (r g b f rgb)
  (map (fn ((cr cg cb))
         (nchar (nearest-color (+ (* cr (- 1 f)) (* r f))
                               (+ (* cg (- 1 f)) (* g f))
                               (+ (* cb (- 1 f)) (* b f))
                               rgb)))
       rgb))

(set digits (map [sym (snoc "STTNUM" (nchar (+ 48 _)))] (iota 10)))

; The status bar: STBAR, the arms panel, ammo, health and armor in big red
; digits, and the face.  Only rebuilt when one of them changes.
(def hud-columns (lv state scr)
  (let ((health armor ammo face) (width height view-h . srest)) (list state scr)
    (withs (cm   (car (at 'colormaps lv))
            draw (fn (cols name x y) (draw-picture cols lv name x y cm view-h (- height 1) view-h scr
                                                   0 (- width 1) nil))
            bar  (foldl (fn ((name x y) cols) (draw cols name x y))
                        (fill width (fill (- height view-h) (nchar 0)))
                        (list '(STBAR 0 168) '(STARMS 104 168)
                              '(STYSNUM2 111 172) '(STGNUM3 123 172) '(STGNUM4 135 172)
                              '(STGNUM5 111 182) '(STGNUM6 123 182) '(STGNUM7 135 182)
                              '(STTPRCNT 90 171) '(STTPRCNT 221 171)
                              (list face 143 168))))
      (number-columns (number-columns (number-columns bar draw ammo 44) draw health 90)
                      draw armor 221))))

; Draw n right-aligned so its last digit ends at x.
(def number-columns (cols draw n x)
  (let ds (number-digits (max 0 n))
    (cadr (foldl (fn (d (x cols))
                   (list (- x 14) (draw cols (nth (+ d 1) digits) (- x 14) 171)))
                 (list x cols)
                 ds))))

(def number-digits (n)
  (if (< n 10) (list n) (cons (mod n 10) (number-digits (floor (/ n 10))))))
