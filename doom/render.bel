; Doom in Bel: the renderer.  (render w) is a function from the world to a
; frame: a list of columns, one per screen column, each a list of chars,
; one per screen row.
;
; Walls are drawn front to back by walking the BSP tree.  The state threaded
; through the walk is (columns solid count planes masked seen):
;
;   columns  per screen column (top bottom tops bottoms clips): rows top to
;            bottom are still open; tops and bottoms are the pixel runs drawn
;            so far above and below them, newest first; clips records
;            (1/z top bottom) each time a wall narrowed the column, for
;            clipping sprites later
;   solid    per column, t once it is closed
;   count    how many columns are closed; the walk stops at the width
;   planes   floor and ceiling tables computed so far, by (start height)
;   masked   see-through middle textures to draw with the sprites
;   seen     sectors drawn, whose things may be visible

;;;; The screen

; The screen record, built once by doom-init from the requested size:
;
;   (width height view-h half-w half-h focal-x focal-y xmap ymap)
;
; view-h   rows of 3D view; the status bar takes the rest, 16% of the
;          height (rounded), as in Doom
; focal-x  width/2: a 90 degree field of view across the width
; focal-y  4/5 of the height.  Doom draws 320x200 with one focal length,
;          160, on both axes, and a 4:3 monitor shows each pixel 1.2 times
;          taller than wide.  Keeping that picture on square pixels means
;          focal-y = focal-x * (height/width) * 4/3 * 1.2, which is 4/5 of
;          the height.  At 160x100 and 320x200 it equals focal-x exactly.
; xmap     for each screen column, the column of Doom's 320x200 screen it
;          shows: floor(x * 320 / width)
; ymap     for each screen row, the row of Doom's 320x200 screen it shows.
;          View rows map onto Doom's 168 view rows, floor(y * 168 / view-h);
;          status bar rows onto its 32 bar rows,
;          168 + floor((y - view-h) * 32 / (height - view-h)), so the bar
;          exactly fills its rows at any height (77 rows at 640x480).
;
; Pictures (weapon, status bar, face, numbers) and the sky are sampled
; through these nearest-neighbour maps, so any scale works, whole or not.
(def make-screen (width height)
  (let view-h (- height (round (/ (* 16 height) 100)))
    (list width height view-h (/ width 2) (/ view-h 2) (/ width 2) (/ (* 4 height) 5)
          (map [floor (/ (* _ 320) width)] (iota width))
          (append (map [floor (/ (* _ 168) view-h)] (iota view-h))
                  (map [+ 168 (floor (/ (* _ 32) (- height view-h)))] (iota (- height view-h)))))))

(def render (w)
  (withs (lv     (at 'lv w)
          scr    (at 'screen w)
          (width height view-h . srest) scr
          angle  (at 'pangle w)
          vcos   (cos angle)
          vsin   (sin angle)
          v      (list (at 'px w) (at 'py w) (eye-z w) vcos vsin (at 'heights w) lv angle
                       (sky-columns lv angle) (view-rays scr vcos vsin) scr)
          st     (render-node (at 'root lv) v
                              (list (fill width (list 0 (- view-h 1) nil nil nil))
                                    (fill width nil) 0 nil nil nil))
          cols   (map column-pixels (car st))
          clips  (map [nth 5 _] (car st))
          scene  (draw-things w v cols clips (nth 5 st) (nth 6 st))
          shot   (draw-weapon w scene)
          tinted (if (> (at 'pain-tics w) 0)  (tint shot (at 'pain-table lv))
                     (> (at 'bonus-tics w) 0) (tint shot (at 'bonus-table lv))
                                              shot))
    (map append tinted (cdr (at 'hud w)))))

(def eye-z (w)
  (+ (at 'pfloor w)
     (if (> (at 'health w) 0)
         view-height
         (max 10 (- view-height (* 3 (at 'dead-tics w)))))))

; A finished column: the runs above, whatever was never drawn (black), and
; the runs below.
(def column-pixels (c)
  (let (top bot tops bots clips) c
    (append (apply append (rev tops))
            (fill (- bot top -1) (nchar 0))
            (apply append bots))))

;;;; The BSP walk

(def render-node (n v st)
  (if (>= (caddr st) (car (nth 11 v)))
      st
      (= (car n) 'sub)
      (foldl (fn (sg st) (render-seg sg v st)) st (cadr n))
      (let ((tag x y dx dy rbox lbox right left) (px py . rest)) (list n v)
        (if (> (* dy (- px x)) (* dx (- py y)))
            (let st (render-node right v st)
              (if (box-visible lbox v (cadr st)) (render-node left v st) st))
            (let st (render-node left v st)
              (if (box-visible rbox v (cadr st)) (render-node right v st) st))))))

(def range-open (xa xb solid)
  (let i (pos nil (drop xa solid))
    (and i (<= i (+ (- xb xa) 1)))))

; Could anything in this node's bounding box still be visible?
(def box-visible (box v solid)
  (let ((top bot left right) (px py vz vcos vsin heights lv angle skycols rays scr)) (list box v)
    (or (and (<= left px right) (<= bot py top))
        (let corners (map (fn ((x y))
                            (with (dx (- x px) dy (- y py))
                              (list (+ (* dx vcos) (* dy vsin)) (- (* dx vsin) (* dy vcos)))))
                          (list (list left top) (list right top)
                                (list left bot) (list right bot)))
          (if (or (all [> (cadr _) (car _)] corners)
                  (all [< (cadr _) (- (car _))] corners)
                  (all [< (car _) near] corners))
              nil
              (some [< (car _) near] corners)
              t
              (let (width height view-h half-w half-h focal-x . srest) scr
                (let xs (map [+ half-w (/ (* (cadr _) focal-x) (car _))] corners)
                  (range-open (max 0 (floor (apply min xs)))
                              (min (- width 1) (floor (apply max xs)))
                              solid))))))))

; Transform a seg into view space, clip it to the near plane, project it,
; and draw its visible columns.
(def render-seg (sg v st)
  (let ((x1 y1 x2 y2 slen uoff . rest) (px py vz vcos vsin . vrest)) (list sg v)
    (if (< (* (- x2 x1) (- py y1)) (* (- y2 y1) (- px x1)))
        (withs (ax (- x1 px) ay (- y1 py) bx (- x2 px) by (- y2 py)
                z1 (+ (* ax vcos) (* ay vsin))
                s1 (- (* ax vsin) (* ay vcos))
                z2 (+ (* bx vcos) (* by vsin))
                s2 (- (* bx vsin) (* by vcos)))
          (if (and (< z1 near) (< z2 near))
              st
              (< z1 near)
              (let f (/ (- near z1) (- z2 z1))
                (project sg v st (+ s1 (* f (- s2 s1))) near (+ uoff (* f slen)) s2 z2 (+ uoff slen)))
              (< z2 near)
              (let f (/ (- near z2) (- z1 z2))
                (project sg v st s1 z1 uoff (+ s2 (* f (- s1 s2))) near (- (+ uoff slen) (* f slen))))
              (project sg v st s1 z1 uoff s2 z2 (+ uoff slen))))
        st)))

(def project (sg v st s1 z1 u1 s2 z2 u2)
  (withs ((width height view-h half-w half-h focal-x . srest) (nth 11 v)
          sx1 (+ half-w (/ (* s1 focal-x) z1))
          sx2 (+ half-w (/ (* s2 focal-x) z2))
          xa  (max 0 (ceil (- sx1 0.5)))
          xb  (min (- width 1) (- (ceil (- sx2 0.5)) 1)))
    (if (and (< sx1 sx2) (<= xa xb) (range-open xa xb (cadr st)))
        (withs (iz1 (/ 1 z1)
                iz2 (/ 1 z2)
                diz (/ (- iz2 iz1) (- sx2 sx1))
                duz (/ (- (* u2 iz2) (* u1 iz1)) (- sx2 sx1))
                dx  (- (+ xa 0.5) sx1))
          (draw-seg sg v st xa xb (+ iz1 (* dx diz)) (+ (* u1 iz1) (* dx duz)) diz duz))
        st)))

;;;; Walls, floors and ceilings

; Distance to a floor or ceiling is constant along a screen row, and so is
; its light, so a plane gets a table of (distance . colormap) per row.
(def plane-table (start h cmaps scr)
  (let ((width height view-h half-w half-h focal-x focal-y . srest) h) (list scr (max h 1))
    (map [let z (/ (* h focal-y) (max (abs (- half-h _ 0.5)) 0.5))
           (cons z (nth (+ 1 (clamp (floor (- start (/ 1280 z))) 0 31)) cmaps))]
         (iota view-h))))

(def with-plane (planes start h cmaps scr)
  (if (get (list start h) planes)
      planes
      (cons (cons (list start h) (plane-table start h cmaps scr)) planes)))

(def plane (planes start h)
  (cdr (get (list start h) planes)))

; Rows ya.. of a floor or ceiling along the view ray (rx, ry): the row's
; distance gives the point on the plane, its low six bits the texel.
(def flat-pixels (tab ya n rows ray px py)
  (let (rx . ry) ray
    (map [nth (nth (+ 1 (mod (floor (+ px (* (car _) rx))) 64))
                   (nth (+ 1 (mod (floor (- 0 py (* (car _) ry))) 64)) rows))
              (cdr _)]
         (first n (drop ya tab)))))

; Rows ya.. of a wall column.  v is the texture row at the center of row
; ya; it grows by step (map units per pixel) down the column.
(def wall-pixels (tex n ya u ttop step cm half-h)
  (if (no tex)
      (fill n (nchar 0))
      (let (w h cols . rest) tex
        (wall-run n (mod (- ttop (* (- half-h ya 0.5) step)) h) step
                  (nth (+ 1 (mod (floor u) w)) cols) h cm nil))))

(def wall-run (n v step tc h cm acc)
  (if (> n 0)
      (wall-run (- n 1) (+ v step) step tc h cm (cons (nth (nth (+ 1 (mod (floor v) h)) tc) cm) acc))
      (rev acc)))

; Draw a seg's columns xa..xb: for each, the ceiling above it, the floor
; below it, and its wall pieces, narrowing the column's open rows.
(def draw-seg (sg v st xa xb iz uz diz duz)
  (withs ((x1 y1 x2 y2 slen uoff yoff fi bi peg-top peg-bottom fake upper mid lower) sg
          (px py vz vcos vsin heights lv angle skycols rays scr) v
          (width height view-h half-w half-h focal-x focal-y . srest) scr
          (cols solid count planes masked seen) st
          sectors (at 'sectors lv)
          cmaps   (at 'colormaps lv)
          (ff fc) (nth (+ fi 1) heights)
          (light fsky frows crows . frest) (nth (+ fi 1) sectors)
          (bf bc) (if bi (nth (+ bi 1) heights) '(0 0))
          bsky    (and bi (cadr (nth (+ bi 1) sectors)))
          start   (light-start light)
          planes  (with-plane (with-plane planes start (- vz ff) cmaps scr) start (- fc vz) cmaps scr)
          ftab    (plane planes start (- vz ff))
          ctab    (plane planes start (- fc vz))
          fh      (- ff vz)
          bfh     (- bf vz)
          bch     (- bc vz)
          ch      (if (and bi fsky bsky) bch (- fc vz))
          wstart  (light-start (+ light (* 16 fake)))
          ttop    (if bi
                      (if upper (if peg-top (- fc vz) (+ bch (cadr upper))))
                      (if mid (if peg-bottom (+ fh (cadr mid)) (- fc vz))))
          btop    (if (and bi lower) (if peg-bottom (- fc vz) bfh))
          mtop    (if (and bi mid)
                      (+ yoff (if peg-bottom (+ (max fh bfh) (cadr mid)) (min (- fc vz) bch))))
          n       (- xb xa -1)
          results (map (fn (c x iz uz skycol ray)
                         (let (top bot tops bots clips) c
                           (if (> top bot)
                               (list c nil)
                               (withs (z     (/ 1 iz)
                                       u     (* uz z)
                                       k     (* focal-y iz)
                                       step  (/ z focal-y)
                                       cm    (nth (+ 1 (clamp (floor (- wstart (min (* 1280 iz) 23))) 0 31))
                                                  cmaps)
                                       yt    (ceil (- half-h (* ch k) 0.5))
                                       yb    (- (ceil (- half-h (* fh k) 0.5)) 1)
                                       top1  (max top (min yt (+ bot 1)))
                                       bot1  (min bot (max yb (- top1 1)))
                                       tops1 (if (> top1 top)
                                                 (cons (if fsky
                                                           (first (- top1 top) (drop top skycol))
                                                           (flat-pixels ctab top (- top1 top) crows ray px py))
                                                       tops)
                                                 tops)
                                       bots1 (if (> bot bot1)
                                                 (cons (flat-pixels ftab (+ bot1 1) (- bot bot1) frows ray px py)
                                                       bots)
                                                 bots))
                                 (if bi
                                     (withs (ybc  (ceil (- half-h (* bch k) 0.5))
                                             ybf  (- (ceil (- half-h (* bfh k) 0.5)) 1)
                                             top2 (if (< bch ch) (max top1 (min ybc (+ bot1 1))) top1)
                                             bot2 (if (> bfh fh) (min bot1 (max ybf (- top2 1))) bot1))
                                       (list (list top2
                                                   bot2
                                                   (if (> top2 top1)
                                                       (cons (wall-pixels upper (- top2 top1) top1 u
                                                                          (+ ttop yoff) step cm half-h)
                                                             tops1)
                                                       tops1)
                                                   (if (> bot1 bot2)
                                                       (cons (wall-pixels lower (- bot1 bot2) (+ bot2 1) u
                                                                          (+ btop yoff) step cm half-h)
                                                             bots1)
                                                       bots1)
                                                   (if (or (> top2 top) (< bot2 bot))
                                                       (cons (list iz top2 bot2) clips)
                                                       clips))
                                             (if (and mid (<= top2 bot2))
                                                 (list x iz u top2 bot2 cm))))
                                     (list (list (+ bot1 1)
                                                 bot1
                                                 (if (>= bot1 top1)
                                                     (cons (wall-pixels mid (- bot1 top1 -1) top1 u
                                                                        (+ ttop yoff) step cm half-h)
                                                           tops1)
                                                     tops1)
                                                 bots1
                                                 (cons (list iz view-h -1) clips))
                                           nil))))))
                       (first n (drop xa cols))
                       (iota-from n xa)
                       (steps n iz diz)
                       (steps n uz duz)
                       (first n (drop xa skycols))
                       (first n (drop xa rays)))
          new     (map car results)
          flags   (map [> (car _) (cadr _)] new)
          mcols   (keep idfn (map cadr results)))
    (list (append (first xa cols) new (drop (+ xb 1) cols))
          (append (first xa solid) flags (drop (+ xb 1) solid))
          (+ count (- (len (keep idfn flags)) (len (keep idfn (first n (drop xa solid))))))
          planes
          (if mcols
              (cons (list (/ 1 (cadr (nth (+ 1 (floor (/ (len mcols) 2))) (rev mcols))))
                          'masked
                          (list mcols mid mtop))
                    masked)
              masked)
          (adjoin fi seen))))

(def iota-from (n x)
  (steps n x 1))

; The sky column for each screen column, by view angle.
(def sky-columns (lv angle)
  (map [nth (+ 1 (mod (floor (* (+ angle _) (/ 512 pi))) 256)) (at 'sky-tables lv)]
       (at 'xangles lv)))

(def view-rays (scr vcos vsin)
  (let (width height view-h half-w half-h focal-x . srest) scr
    (map [let k (/ (- (+ _ 0.5) half-w) focal-x)
           (cons (+ vcos (* k vsin)) (- vsin (* k vcos)))]
         (iota width))))

;;;; Sprites

; Things in sectors we drew, and see-through middles, painted far to near
; over the walls.  A sprite column at depth z is clipped by the newest wall
; nearer than z in that column's clip records.
(def draw-things (w v cols clips masked seen)
  (foldl (fn ((z s m) cols)
           (if (= s 'masked)
               (apply draw-masked cols v m)
               (draw-sprite cols clips w v m z s)))
         cols
         (sort (fn (a b) (> (car a) (car b)))
               (append masked
                       (keep idfn (map [sprite-item _ v]
                                       (keep [mem (at 'sec _) seen] (at 'mobjs w))))))))

(def sprite-item (m v)
  (withs ((px py vz vcos vsin . rest) v
          dx (- (at 'x m) px)
          dy (- (at 'y m) py)
          z  (+ (* dx vcos) (* dy vsin))
          s  (- (* dx vsin) (* dy vcos)))
    (if (and (> z 4) (< (abs s) (+ z 64)))
        (list z s m))))

; The frame a thing shows: its own, or a looping animation by the clock.
(def thing-frame (m tic)
  (or (at 'frame m)
      (let frames (at 'frames m)
        (nth (+ 1 (mod (floor (/ tic 4)) (len frames))) frames))))

; Which of the eight rotations faces us: 1 is the front.
(def sprite-rotation (m px py)
  (mod (floor (/ (+ (- (atan2 (- (at 'y m) py) (- (at 'x m) px)) (at 'angle m)) (* pi 1.125))
                 (* pi 0.25)))
       8))

(def draw-sprite (cols clips w v m z s)
  (withs ((px py vz vcos vsin heights lv angle skycols rays scr) v
          (width height view-h half-w half-h focal-x focal-y . srest) scr
          rots (cdr (get (sym (snoc (at 'sprite m) (thing-frame m (at 'tic w))))
                         (at 'sprite-frames lv))))
    (if (no rots)
        cols
        (withs ((name . flip)     (or (nth (+ 1 (if (id (car rots) (cadr rots)) 0 (sprite-rotation m px py)))
                                           rots)
                                      (car rots))
                (pw ph lo to pcols) (cdr (get name (at 'pictures lv)))
                si    (at 'sec m)
                (flo cei) (nth (+ si 1) heights)
                mz    (or (at 'z m) (if (= (at 'class m) 'hanging) (- cei to) flo))
                xscale (/ focal-x z)
                xstep  (/ z focal-x)
                yscale (/ focal-y z)
                ystep  (/ z focal-y)
                iz     (/ 1 z)
                x1     (+ half-w (* (- s lo) xscale))
                xa     (max 0 (ceil (- x1 0.5)))
                xb     (min (- width 1) (- (ceil (- (+ x1 (* pw xscale)) 0.5)) 1))
                ytop   (- half-h (* (- (+ mz to) vz) yscale))
                ya0    (ceil (- ytop 0.5))
                yb0    (- (ceil (- (+ ytop (* ph yscale)) 0.5)) 1)
                cmaps (at 'colormaps lv)
                cm    (if (at 'bright m)
                          (car cmaps)
                          (nth (+ 1 (clamp (floor (- (light-start (car (nth (+ si 1) (at 'sectors lv))))
                                                     (min (* 1280 iz) 23)))
                                           0 31))
                               cmaps)))
          (if (> xa xb)
              cols
              (overlay-columns
                cols xa
                (map (fn (x evs)
                       (withs (tx        (clamp (floor (* (- (+ x 0.5) x1) xstep)) 0 (- pw 1))
                               ev        (find [> (car _) iz] evs)
                               (top bot) (if ev (cdr ev) (list 0 (- view-h 1)))
                               ya        (max ya0 top)
                               yb        (min yb0 bot))
                         (if (<= ya yb)
                             (cons ya (sprite-run (- yb ya -1) (* (- (+ ya 0.5) ytop) ystep) ystep
                                                  (nth (+ 1 (if flip (- pw 1 tx) tx)) pcols) cm nil)))))
                     (iota-from (- xb xa -1) xa)
                     (first (- xb xa -1) (drop xa clips)))))))))

; Texels of a sprite column; nil where it is transparent.
(def sprite-run (n v step pcol cm acc)
  (if (> n 0)
      (sprite-run (- n 1) (+ v step) step pcol cm
                  (cons (let c (car (drop (floor v) pcol))
                          (if (and c (> c 0)) (nth c cm)))
                        acc))
      (rev acc)))

; Lay runs of pixels (nil = see-through) over columns xa onward; each
; datum is (top-row . pixels) or nil.
(def overlay-columns (cols xa data)
  (let n (len data)
    (append (first xa cols)
            (map (fn (col d) (if d (overlay-pixels col (car d) (cdr d)) col))
                 (first n (drop xa cols))
                 data)
            (drop (+ xa n) cols))))

(def overlay-pixels (col ya pix)
  (append (first ya col)
          (map (fn (new old) (or new old)) pix (drop ya col))
          (drop (+ ya (len pix)) col)))

; The see-through middle texture of a two-sided line (grates, fences),
; drawn once between floor and ceiling.  Each column was recorded as
; (x 1/z u top bottom colormap).
(def draw-masked (cols v mcols tex mtop)
  (let ((w h walls masked) (width height view-h half-w half-h focal-x focal-y . srest)) (list tex (nth 11 v))
    (foldl (fn ((x iz u top bot cm) cols)
             (withs (k    (* focal-y iz)
                     ytop (- half-h (* mtop k))
                     ya   (max top (ceil (- ytop 0.5)))
                     yb   (min bot (- (ceil (- (+ ytop (* h k)) 0.5)) 1)))
               (if (<= ya yb)
                   (overlay-columns cols x
                     (list (cons ya (sprite-run (- yb ya -1) (/ (- (+ ya 0.5) ytop) k) (/ 1 k)
                                                (nth (+ 1 (mod (floor u) w)) masked) cm nil))))
                   cols)))
           cols
           mcols)))

;;;; Pictures: the weapon and the status bar

; The pixels of a picture placed at Doom's 320x200 screen coordinates,
; sampled through the screen's maps, over screen rows ya..yb:
; (first-column . data) for overlay-columns, with rows counted from row0.
(def picture-data (pic x y cm ya yb row0 scr)
  (let ((w h lo to cols) (width height view-h half-w half-h focal-x focal-y xmap ymap)) (list pic scr)
    (withs (left (floor (- x lo))
            top  (floor (- y to))
            xs   (keep [<= left (nth (+ _ 1) xmap) (+ left w -1)] (iota width))
            ys   (keep [<= top (nth (+ _ 1) ymap) (+ top h -1)] (iota-from (- yb ya -1) ya))
            src  (map [- (nth (+ _ 1) ymap) top] ys))
      (if (and xs ys)
          (cons (car xs)
                (map [let pcol (nth (+ 1 (- (nth (+ _ 1) xmap) left)) cols)
                       (cons (- (car ys) row0)
                             (map [let c (nth (+ _ 1) pcol) (if (> c 0) (nth c cm))] src))]
                     xs))))))

(def draw-picture (cols lv name x y cm ya yb row0 scr)
  (let d (picture-data (cdr (get name (at 'pictures lv))) x y cm ya yb row0 scr)
    (if d (overlay-columns cols (car d) (cdr d)) cols)))

(set pistol-frames (map [cons _ (sym (list \P \I \S \G _ \0))] "ABC"))

(def draw-weapon (w cols)
  (if (> (at 'health w) 0)
      (withs (lv    (at 'lv w)
              scr   (at 'screen w)
              vh    (caddr scr)
              wt    (at 'wtics w)
              frame (if (> wt 9) \B (> wt 5) \C (> wt 2) \B \A)
              phase (* (at 'tic w) 0.2)
              bob   (at 'bob w)
              bx    (if (> wt 0) 0 (* bob 6 (cos phase)))
              by    (if (> wt 0) 0 (* bob 4 (abs (sin phase))))
              cmaps (at 'colormaps lv)
              cm    (nth (+ 1 (clamp (- (light-start (car (nth (+ 1 (at 'psec w)) (at 'sectors lv)))) 23)
                                     0 31))
                         cmaps)
              lit   (if (> wt 9)
                        (draw-picture cols lv 'PISFA0 (+ 1 bx) (+ 16 by) (car cmaps) 0 (- vh 1) 0 scr)
                        cols))
        (draw-picture lit lv (cdr (get frame pistol-frames)) (+ 1 bx) (+ 16 by) cm 0 (- vh 1) 0 scr))
      cols))

; Doom flashes the palette red when you are hurt and gold when you pick
; something up.  We have one palette, so we remap the view through a table
; of the nearest colors to each color blended toward red or gold.
(def tint-table (r g b f rgb)
  (map (fn ((cr cg cb))
         (nchar (nearest-color (+ (* cr (- 1 f)) (* r f))
                               (+ (* cg (- 1 f)) (* g f))
                               (+ (* cb (- 1 f)) (* b f))
                               rgb)))
       rgb))

(def tint (cols tab)
  (map [map [nth (+ 1 (charn _)) tab] _] cols))

(set digits (map [sym (snoc "STTNUM" (nchar (+ 48 _)))] (iota 10)))

; The status bar: STBAR, the arms panel, ammo, health and armor in big red
; digits, and the face.  Only rebuilt when one of them changes.
(def hud-columns (lv state scr)
  (let ((health armor ammo face) (width height view-h . srest)) (list state scr)
    (withs (cm   (car (at 'colormaps lv))
            draw (fn (cols name x y) (draw-picture cols lv name x y cm view-h (- height 1) view-h scr))
            bar  (foldl (fn ((name x y) cols) (draw cols name x y))
                        (fill width (fill (- height view-h) (nchar 0)))
                        (list '(STBAR 0 168) '(STARMS 104 168)
                              '(STYSNUM2 111 172) '(STGNUM3 123 172) '(STGNUM4 135 172)
                              '(STGNUM5 111 182) '(STGNUM6 123 182) '(STGNUM7 135 182)
                              '(STTPRCNT 90 171) '(STTPRCNT 221 171)
                              (list face 143 168))))
      (number-columns (number-columns (number-columns bar draw ammo 44) draw health 90)
                      draw armor 221))))

; Draw n right-aligned so its last digit ends at x.
(def number-columns (cols draw n x)
  (let ds (number-digits (max 0 n))
    (cadr (foldl (fn (d (x cols))
                   (list (- x 14) (draw cols (nth (+ d 1) digits) (- x 14) 171)))
                 (list x cols)
                 ds))))

(def number-digits (n)
  (if (< n 10) (list n) (cons (mod n 10) (number-digits (floor (/ n 10))))))
